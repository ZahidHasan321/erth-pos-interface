# Local rehearsal on this machine: *.localhost with Caddy's internal CA.
#   cp .env.local.example .env && docker compose up -d --build
SHOP_DOMAIN=shop.localhost
WORKSHOP_DOMAIN=workshop.localhost
ADMIN_DOMAIN=admin.localhost
API_DOMAIN=api.localhost
API_ORIGIN=https://api.localhost:18443
APP_ORIGINS=https://shop.localhost:18443,https://workshop.localhost:18443,https://admin.localhost:18443,http://localhost:5173,http://localhost:5174,http://localhost:5175
ACME_EMAIL=dev@localhost
CADDY_GLOBAL_EXTRA=local_certs

POSTGRES_PASSWORD=local-postgres-pw
AUTHENTICATOR_PASSWORD=local-authenticator-pw
API_SERVER_PASSWORD=local-api-server-pw
JWT_SECRET=local-dev-jwt-secret-at-least-32-characters-long

# Cloudflare's documented always-pass Turnstile TEST keys.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB

HTTP_PORT=18080
HTTPS_PORT=18443
DB_PORT=55432
