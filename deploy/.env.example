# Copy to deploy/.env and fill in. deploy/.env is gitignored — keep it that way.
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+='

# ── Hostnames (DNS A/AAAA records → the VPS) ─────────────────────────────────
SHOP_DOMAIN=shop.example.com
WORKSHOP_DOMAIN=workshop.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
# Full origins (scheme + host [+ port]). API_ORIGIN is baked into the SPAs.
API_ORIGIN=https://api.example.com
APP_ORIGINS=https://shop.example.com,https://workshop.example.com,https://admin.example.com
ACME_EMAIL=ops@example.com

# ── Secrets ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
API_SERVER_PASSWORD=
# >= 32 chars. Signs every access token; rotating it logs everyone out.
JWT_SECRET=

# ── Cloudflare Turnstile (optional; login captcha after 3 failed tries) ───────
# Cloudflare dashboard → Turnstile → add widget (managed) for the app hostnames.
# Leave both empty to disable the captcha step (try limits still apply).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Tuning (defaults suit a 4 GB VPS; ~25% / 75% of RAM) ─────────────────────
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB

# ── Ports (leave as-is on the VPS) ───────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
DB_PORT=5432
